<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scan_add_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/sa_top"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/sa_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dark_button"
                android:contentDescription="@string/action_back"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/sa_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/scan_add_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/sa_torch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dark_button"
                android:contentDescription="@string/hint_torch"
                android:padding="10dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="70dp">

            <FrameLayout
                android:id="@+id/sa_frame"
                android:layout_width="232dp"
                android:layout_height="232dp"
                android:background="@drawable/bg_scan_frame"
                android:clipToOutline="true">

                <androidx.camera.view.PreviewView
                    android:id="@+id/sa_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.example.pricescanner.ScannerOverlayView
                    android:id="@+id/sa_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/sa_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/scan_add_hint"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

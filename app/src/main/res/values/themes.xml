<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PriceScanner" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorAccent">@color/blue</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink2</item>
    </style>

    <style name="Theme.PriceScanner.ScanAdd" parent="Theme.PriceScanner">
        <item name="android:windowBackground">@color/scan_add_bg</item>
        <item name="android:statusBarColor">@color/scan_add_bg</item>
        <item name="android:navigationBarColor">@color/scan_add_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.PriceScanner.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">@color/blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <style name="Text.Label" parent="android:Widget.TextView">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="Text.Action" parent="android:Widget.TextView">
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Text.SheetTitle" parent="android:Widget.TextView">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.SheetLabel" parent="android:Widget.TextView">
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="Text.Tab" parent="android:Widget.TextView">
        <item name="android:textSize">10.5sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
